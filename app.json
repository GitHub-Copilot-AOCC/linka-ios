{
  "expo": {
    "name": "Linka",
    "slug": "linka-ios",
    "scheme": "linka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linkaios.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Linka 需要使用麥克風錄音，用於 AI 語音快速記錄功能。"
        }
      ],
      "expo-localization",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Linka 需要存取相簿，用於選擇聯絡人照片或名片圖片。",
          "cameraPermission": "Linka 需要使用相機，用於拍攝名片或聯絡人照片。"
        }
      ],
      "expo-document-picker",
      "expo-sharing",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "a3f4ca33-a6f5-468d-ae5c-1975781f210d"
      }
    },
    "owner": "marvinhsu"
  }
}
