# Cloud Functions（geminiProxy，見 spec.md §5.5、§8.5，跟 Web 版共用同一個 Cloud Function）
EXPO_PUBLIC_GEMINI_PROXY_URL=https://us-central1-your_project_id.cloudfunctions.net/geminiProxy

# Firebase Configuration（跟 Web 版（GitHub-Copilot-AOCC/Linka）共用同一個 Firebase 專案，
# 同一批使用者/聯絡人資料，不要另外建立新專案）
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google 登入（見 src/ui/screens/LoginScreen.tsx 的說明）：
# 要在 Google Cloud Console（跟 Firebase 專案同一個 GCP 專案）手動建立一個「iOS」類型的
# OAuth Client ID，Bundle ID 填 app.json 的 com.linka.app，建立後把 Client ID 貼在這裡。
# 這步是 Google Cloud Console 的手動操作，AI agent 沒有帳號權限代為建立。
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_oauth_client_id.apps.googleusercontent.com
